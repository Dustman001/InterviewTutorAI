{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Uri": ""
  },
  "AzureSpeech": {
    "Region": "",
    "Locale": "en-US",
    "Voice": "en-US-AvaMultilingualNeural",
    "Accents": {
      "en-US": { "Label": "American English", "Voice": "en-US-AvaMultilingualNeural" },
      "en-GB": {
        "Label": "British English",
        "Voice": "en-GB-SoniaNeural",
        "PromptNote": "Use British English vocabulary, idioms and spelling (for example flat, holiday, colour)."
      },
      "en-AU": {
        "Label": "Australian English",
        "Voice": "en-AU-NatashaNeural",
        "PromptNote": "Use Australian English vocabulary and idioms."
      },
      "en-IN": {
        "Label": "Indian English",
        "Voice": "en-IN-NeerjaNeural",
        "PromptNote": "Use Indian English vocabulary and idioms."
      }
    }
  },
  "Anthropic": {
    "ConversationModel": "claude-sonnet-5-5",
    "GradingModel": "claude-opus-5-5"
  },
  "Auth": {
    "Issuer": "TutorAI.Api",
    "Audience": "TutorAI.Web",
    "TokenLifetimeMinutes": 15,
    "AdminUsername": "admin",
    "LockoutThreshold": 5,
    "LockoutBaseSeconds": 60,
    "LockoutMaxSeconds": 900,
    "LoginAttemptsPerMinute": 30
  },
  "Sessions": {
    "MinDurationMinutes": 5,
    "MaxDurationMinutes": 60,
    "GraceMinutes": 5,
    "MaxUserTurns": 150,
    "MaxTurnChars": 4000,
    "MaxPhrasesPerTurn": 100,
    "MaxRequestBytes": 4194304,
    "MaxScenarioFieldChars": 200,
    "MaxJobDescriptionChars": 8000,
    "TurnsPerMinute": 20
  },
  "Pricing": {
    "claude-sonnet-5-5": { "InputPerMTok": 2, "OutputPerMTok": 10, "CacheReadPerMTok": 0.2, "CacheWritePerMTok": 2.5 },
    "claude-opus-5-5": { "InputPerMTok": 4, "OutputPerMTok": 20, "CacheReadPerMTok": 0.2, "CacheWritePerMTok": 5 }
  },
  "Assessment": {
    "MinUserWords": 150,
    "MaxGradingAttempts": 3,
    "RetryDelaySeconds": [ 15, 60 ],
    "GradingTimeoutSeconds": 300,
    "StaleGradingMinutes": 10,
    "GradingConcurrency": 2
  }
}
