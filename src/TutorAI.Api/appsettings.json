{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Uri": ""
  },
  "AzureSpeech": {
    "Region": "",
    "Locale": "en-US",
    "Voice": "en-US-AvaMultilingualNeural"
  },
  "Anthropic": {
    "ConversationModel": "claude-sonnet-5-5",
    "GradingModel": "claude-opus-5-5"
  },
  "Auth": {
    "Issuer": "TutorAI.Api",
    "Audience": "TutorAI.Web",
    "TokenLifetimeMinutes": 15,
    "AdminUsername": "admin",
    "GuestUsername": "guest",
    "GuestSessionLimit": 3
  },
  "Assessment": {
    "MinUserWords": 150
  }
}
