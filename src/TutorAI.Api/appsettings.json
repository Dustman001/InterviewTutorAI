{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Uri": ""
  },
  "AzureSpeech": {
    "Region": "",
    "Locale": "en-US",
    "Voice": "en-US-AvaMultilingualNeural"
  },
  "Anthropic": {
    "ConversationModel": "claude-sonnet-5-5",
    "GradingModel": "claude-opus-5-5"
  },
  "Auth": {
    "Issuer": "TutorAI.Api",
    "Audience": "TutorAI.Web",
    "TokenLifetimeMinutes": 15,
    "AdminUsername": "admin",
    "LockoutThreshold": 5,
    "LockoutBaseSeconds": 60,
    "LockoutMaxSeconds": 900,
    "LoginAttemptsPerMinute": 30
  },
  "Sessions": {
    "MinDurationMinutes": 5,
    "MaxDurationMinutes": 60,
    "GraceMinutes": 5,
    "MaxUserTurns": 150,
    "MaxTurnChars": 4000,
    "MaxPhrasesPerTurn": 100,
    "MaxRequestBytes": 4194304,
    "MaxScenarioFieldChars": 200,
    "MaxJobDescriptionChars": 8000,
    "TurnsPerMinute": 20
  },
  "Assessment": {
    "MinUserWords": 150
  }
}
